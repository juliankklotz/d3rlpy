#!/bin/bash -eu
# Create or rebuild the thesis conda environment on any machine (local or cluster).
# Usage: bash scripts/cluster_env_setup [--rebuild]
#
# Works with both personal miniconda (~/) and shared system conda (/opt/...).
# User envs on shared systems go to ~/.conda/envs/ — this is handled automatically.
#
# Pass --rebuild to delete and recreate the env from scratch.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$SCRIPT_DIR/.."
ENV_NAME="d3rlpy_dev_final_py310"

# --- locate conda -------------------------------------------------------
if ! command -v conda &>/dev/null; then
    # Try common locations
    for candidate in "$HOME/miniconda3" "$HOME/anaconda3" "/opt/sw/conda/miniconda3-24.1.2"; do
        if [ -f "$candidate/etc/profile.d/conda.sh" ]; then
            source "$candidate/etc/profile.d/conda.sh"
            break
        fi
    done
fi
command -v conda &>/dev/null || { echo "ERROR: conda not found" >&2; exit 1; }

# --- optionally rebuild -------------------------------------------------
if [[ "${1:-}" == "--rebuild" ]]; then
    echo "Removing existing env $ENV_NAME ..."
    conda env remove -n "$ENV_NAME" -y 2>/dev/null || true
fi

# --- create env if missing ----------------------------------------------
if ! conda env list | grep -qE "^${ENV_NAME}\s"; then
    echo "Creating conda env $ENV_NAME ..."
    conda create -n "$ENV_NAME" python=3.10 pip -y
fi

# --- find actual env path (handles shared conda where envs go to ~/.conda) ---
ENV_PATH="$(conda env list | grep -E "^${ENV_NAME}\s" | awk '{print $NF}')"
if [ -z "$ENV_PATH" ]; then
    echo "ERROR: env $ENV_NAME not found after creation" >&2
    exit 1
fi
PYTHON="$ENV_PATH/bin/python"
PIP="$ENV_PATH/bin/pip"
echo "Env path:  $ENV_PATH"
echo "Python:    $PYTHON"

# --- install deps in safe order -----------------------------------------
# typing-extensions MUST be installed before requirements.txt is processed
# because requirements.txt used to pin it to 3.7.x which breaks torch 2.5+
echo ""
echo "Installing typing-extensions first (prevents torch downgrade) ..."
"$PIP" install "typing-extensions>=4.8.0" --quiet

echo "Installing torch ..."
"$PIP" install "torch>=2.5.0" --quiet

echo "Installing requirements ..."
cd "$REPO_DIR"
"$PIP" install -r requirements.txt --quiet
"$PIP" install -r dev.requirements.txt --quiet
"$PIP" install -e . --quiet

# --- validation ---------------------------------------------------------
echo ""
echo "=== validating environment ==="

"$PYTHON" - <<'PYCHECK'
import sys, importlib, importlib.metadata

failed = []
checks = [
    ("torch",                                          lambda m: m.__version__),
    ("gymnasium",                                      lambda m: m.__version__),
    ("numpy",                                          lambda m: m.__version__),
    ("pandas",                                         lambda m: m.__version__),
    ("dataclasses_json",                               lambda m: "ok"),
    ("d3rlpy",                                         lambda m: "ok"),
    ("d3rlpy.algos.DiscreteBCConfig",                  lambda _: "ok"),
    ("d3rlpy.algos.DiscreteCQLConfig",                 lambda _: "ok"),
    ("d3rlpy.algos.DiscreteDecisionTransformerConfig", lambda _: "ok"),
    ("d3rlpy.algos.DiscreteTACRConfig",                lambda _: "ok"),
    ("d3rlpy.ope.DiscreteFQE",                         lambda _: "ok"),
    ("d3rlpy.sepsis_loader.get_sepsis",                lambda _: "ok"),
]

for dotpath, info_fn in checks:
    parts = dotpath.rsplit(".", 1)
    mod_path, attr = (parts[0], parts[1]) if len(parts) == 2 else (parts[0], None)
    try:
        m = importlib.import_module(mod_path)
        obj = getattr(m, attr) if attr else m
        ver = info_fn(obj)
        print(f"  OK  {dotpath}  ({ver})")
    except Exception as e:
        print(f"  FAIL {dotpath}: {e}", file=sys.stderr)
        failed.append(dotpath)

# Check typing_extensions version via metadata (module may lack __version__)
try:
    te_ver = importlib.metadata.version("typing_extensions")
    te_tuple = tuple(int(x) for x in te_ver.split(".")[:2])
    if te_tuple < (4, 8):
        print(f"  FAIL typing_extensions=={te_ver} < 4.8.0 (torch will break)", file=sys.stderr)
        failed.append("typing_extensions")
    else:
        print(f"  OK  typing_extensions  ({te_ver})")
except Exception as e:
    print(f"  FAIL typing_extensions not installed: {e}", file=sys.stderr)
    failed.append("typing_extensions")

if failed:
    print(f"\nFAILED: {failed}", file=sys.stderr)
    sys.exit(1)
print("\nAll import checks passed.")
PYCHECK

echo ""
echo "=== running smoke tests ==="
cd "$REPO_DIR"
KMP_DUPLICATE_LIB_OK=True "$PYTHON" -m pytest tests/test_smoke.py -q --no-header -p no:warnings

echo ""
echo "=== environment ready ==="
echo "Python: $PYTHON"
"$PYTHON" -c "import torch; print('torch:', torch.__version__)"
echo ""
echo "To use in SLURM scripts, set:"
echo "  PYTHON=\"$PYTHON\""
